# Environment variables read by the API. Spring reads real environment variables,
# so export these (or set them in your host's dashboard). Placeholders only.

# --- required ---
JWT_SECRET=replace-with-at-least-32-random-characters
DB_URL=jdbc:postgresql://localhost:5432/stockpilot
DB_USER=postgres
DB_PASSWORD=replace-me

# --- optional ---
# Allowed browser origins (comma separated). Set to your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173
PORT=8080
JWT_EXPIRES_MINUTES=480
BCRYPT_STRENGTH=10
DB_POOL_MAX=10
AUTH_RATE_LIMIT_PER_MINUTE=20
# Load idempotent synthetic demo data on boot (demo deployment only)
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=choose-a-demo-password
